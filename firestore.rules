rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Users can read/create their own profile. Only an admin can change
    // someone's role (promote to admin/teacher) — this field is protected
    // below so students can never self-promote.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || (isTeacher() && resource.data.role == 'student');
      allow create: if isOwner(uid) &&
        request.resource.data.role == 'student';
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Topics and questions: everyone signed in can read (needed to take
    // tests); only admins can write.
    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Uploaded PDFs/notes/images metadata: everyone signed in can read
    // (needed to browse the library); only admins can add/remove entries.
    // Any signed-in user may bump downloadCount (and only that field) so
    // the "most downloaded" analytics stat stays accurate.
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount']));
    }

    // Extracted PDF text, one doc per page, used for in-document search.
    // Same access pattern as the parent material: readable by anyone
    // signed in, written only by an admin's browser during upload.
    match /materials/{materialId}/pages/{pageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Aggregate analytics collections: written incrementally by any
    // signed-in student as they submit tests or download materials, but
    // only readable by admins. These hold counters only (attempts,
    // correct, score sums) — no personal data.
    match /questionStats/{questionId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
    match /topicStats/{topicId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    // Leaderboard entries are keyed by the student's own uid, so the rule
    // can guarantee nobody can write (or inflate) another student's score.
    match /leaderboardWeekly/{weekKey}/entries/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }
    match /leaderboardMonthly/{monthKey}/entries/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }
    match /leaderboardAllTime/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Adaptive practice sessions: a student can save and read only their
    // own history. Immutable once written, same as formal test results.
    match /adaptiveSessions/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Written only by netlify/functions/evolve.ts via the Firebase Admin
    // SDK, which bypasses these rules entirely — so "write: if false" here
    // just means no client (not even an admin) can fake a log entry.
    match /evolutionLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Push subscriptions: a student can register/remove their own device.
    // Reading is admin-only (needed for potential future device-management
    // UI); the actual send job runs via the Admin SDK, which bypasses
    // these rules entirely regardless.
    match /pushSubscriptions/{subId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update: if false;
    }

    // A student's own bookmarks — never visible to other students.
    match /users/{uid}/bookmarks/{materialId} {
      allow read, write: if isOwner(uid);
    }

    // Test papers: a student can create their own generated paper and
    // read it back; nobody can edit a paper once created (prevents
    // tampering with which questions were served).
    match /testPapers/{paperId} {
      allow create: if isSignedIn() && request.resource.data.config.studentUid == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.config.studentUid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Results: a student can create and read only their own results.
    // Immutable after submission to keep scores trustworthy. A teacher
    // may also read a result if it's tied to one of their own custom
    // tests (checked via a lookup on the linked customTests doc).
    match /results/{resultId} {
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin() ||
        (('customTestId' in resource.data) &&
          get(/databases/$(database)/documents/customTests/$(resource.data.customTestId)).data.teacherUid == request.auth.uid)
      );
      allow update, delete: if false;
    }

    // Custom tests: a teacher (or admin) can create their own; students
    // need read access to see tests assigned to them. Only the owning
    // teacher or an admin can edit/delete.
    match /customTests/{testId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isTeacher() || isAdmin()) && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isAdmin() || resource.data.teacherUid == request.auth.uid;
    }

    // Announcements: admin-authored, readable by all signed-in users.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
