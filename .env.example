# Copy this file to .env for local development.
# In Netlify: Site settings -> Environment variables -> add each of these.
# All VITE_ vars are exposed to the browser bundle (that's normal and safe
# for Firebase web config, which is not a secret). Secret AI keys go ONLY
# in the Netlify Function environment variables below (never prefixed VITE_).

# --- Firebase web app config (Project settings -> General -> Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI provider keys (used ONLY by the Netlify Function, never sent to the browser) ---
# Set these in Netlify's dashboard, not in a committed .env file.
OPENAI_API_KEY=
GEMINI_API_KEY=
